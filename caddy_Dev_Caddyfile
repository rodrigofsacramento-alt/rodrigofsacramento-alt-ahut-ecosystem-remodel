# ============================================================
# CADDYFILE — Proxy do ambiente de DEV
# dev.ahut-ecosystem.apexfyhub.com.br → localhost:5173 (Vite dev)
#
# COMO APLICAR (exige root na VPS 2.24.95.98):
#   1. Criar registro DNS na Hostinger:
#      Tipo: A | Nome: dev | Conteúdo/IP: 2.24.95.98 | TTL: 3600
#   2. Instalar Caddy (root):
#      sudo apt update && sudo apt install -y caddy
#   3. Salvar este arquivo como /etc/caddy/Caddyfile (ou /opt/caddy/Caddyfile)
#   4. sudo systemctl enable --now caddy
#   5. O Caddy obtém SSL automático (Let's Encrypt) para o domínio.
#
# OBSERVAÇÃO: como é proxy para o Vite dev (hot reload), as alterações
# aparecem em tempo real ao validar. Alternativa produtiva: servir o build
# estático (Caddyfile file_server) apontando para /dist.
# ============================================================

dev.ahut-ecosystem.apexfyhub.com.br {
    # Proxy para o Vite dev server (porta 5173) — atualizações em tempo real
    reverse_proxy 127.0.0.1:5173

    # Headers de segurança
    header {
        X-Content-Type-Options "nosniff"
        X-Frame-Options "DENY"
    }
}

